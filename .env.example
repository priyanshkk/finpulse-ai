# Copy to .env. Never commit real credentials.
DATABASE_URL=sqlite:///./data/finpulse.db
GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-2.0-flash
MAX_UPLOAD_MB=10
SEED_ON_START=1
APP_PORT=8000
LOG_LEVEL=info
# Optional PostgreSQL: postgresql+psycopg://user:pass@localhost:5432/finpulse
# Leave GEMINI_API_KEY empty (or your_key_here) for offline text parsing.
